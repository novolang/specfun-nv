// specerf_tests.nv — the error function, and the reason its
// complement is a function of its own.
//
// RED ON PURPOSE: every assertion reaches `not implemented:
// specfun-nv.specerf.<fn>`.
//
// The reference values are scipy.special's at the arguments its own
// test suite uses.  The oddness of `erf`, the round trip through the
// inverses and the identity `erf(x) + erfc(x) = 1` are asserted as
// identities, because an identity constrains the implementation at
// every argument rather than at one.

use std.test
use specerf

@test
fn test_erf_at_the_values_scipy_publishes() [io]
    test.case("erf(0) is 0 and erf(1) is 0.8427007929497149")
    match specerf.erf(0.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 0.0, 1e-15)
    match specerf.erf(1.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 0.8427007929497149, 1e-14)

    test.case("erf is odd: erf(-x) is -erf(x), at every argument")
    match specerf.erf(-1.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, -0.8427007929497149, 1e-14)
    match specerf.erf(-0.5)
        Err(e) => test.fail(e.message())
        Ok(a)  =>
            match specerf.erf(0.5)
                Err(e) => test.fail(e.message())
                Ok(b)  => test.assert_approx(a + b, 0.0, 1e-15)

    test.case("and it saturates rather than overflowing")
    match specerf.erf(30.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 1.0, 1e-15)

@test
fn test_erfc_is_the_tail_and_not_one_minus_erf() [io]
    // The single most common accuracy mistake in statistical code.
    // At an argument of 6, `1 - erf(x)` has about two correct digits
    // out of sixteen and `erfc(x)` has them all.
    test.case("erfc(1) is 0.15729920705028513")
    match specerf.erfc(1.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 0.15729920705028513, 1e-15)

    test.case("erfc(0) is 1 and erfc(-1) is 2 - erfc(1)")
    match specerf.erfc(0.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 1.0, 1e-15)
    match specerf.erfc(-1.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 1.8427007929497148, 1e-14)

    test.case("erf and erfc sum to 1 at every argument")
    match specerf.erf(0.7)
        Err(e) => test.fail(e.message())
        Ok(a)  =>
            match specerf.erfc(0.7)
                Err(e) => test.fail(e.message())
                Ok(b)  => test.assert_approx(a + b, 1.0, 1e-15)

    test.case("and the far tail keeps its RELATIVE accuracy, which is the whole point")
    match specerf.erfc(6.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v / 2.1519736712498916e-17, 1.0, 1e-12)

@test
fn test_erfcx_removes_the_exponential_decay() [io]
    test.case("erfcx(0) is erfc(0), which is 1")
    match specerf.erfcx(0.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 1.0, 1e-15)

    test.case("at 10 it is about 0.056, where erfc itself is 2.09e-45")
    match specerf.erfcx(10.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 0.05614099274382258, 1e-12)

@test
fn test_the_inverses_round_trip_and_refuse_their_endpoints() [io]
    test.case("erf_inv(0) is 0 and erfc_inv(1) is 0")
    match specerf.erf_inv(0.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 0.0, 1e-15)
    match specerf.erfc_inv(1.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 0.0, 1e-15)

    test.case("erf_inv(erf(x)) is x")
    match specerf.erf_inv(0.8427007929497149)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 1.0, 1e-13)

    test.case("erfc_inv(erfc(x)) is x")
    match specerf.erfc_inv(0.15729920705028513)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 1.0, 1e-13)

    test.case("erf_inv is defined on the OPEN interval (-1, 1), so both endpoints are refused")
    match specerf.erf_inv(1.0)
        Ok(_)  => test.fail("erf_inv(1) is an infinity, not a number")
        Err(_) => test.assert(true)
    match specerf.erf_inv(-1.0)
        Ok(_)  => test.fail("erf_inv(-1) is an infinity, not a number")
        Err(_) => test.assert(true)
    match specerf.erf_inv(1.5)
        Ok(_)  => test.fail("1.5 is not a value the error function takes")
        Err(_) => test.assert(true)

    test.case("and erfc_inv on the open interval (0, 2)")
    match specerf.erfc_inv(0.0)
        Ok(_)  => test.fail("erfc_inv(0) is an infinity, not a number")
        Err(_) => test.assert(true)
    match specerf.erfc_inv(2.0)
        Ok(_)  => test.fail("erfc_inv(2) is an infinity, not a number")
        Err(_) => test.assert(true)

@test
fn test_dawsons_integral_is_odd_and_peaks_below_one() [io]
    test.case("dawson(0) is 0")
    match specerf.dawson(0.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 0.0, 1e-15)

    test.case("it is odd, like erf")
    match specerf.dawson(1.0)
        Err(e) => test.fail(e.message())
        Ok(a)  =>
            match specerf.dawson(-1.0)
                Err(e) => test.fail(e.message())
                Ok(b)  => test.assert_approx(a + b, 0.0, 1e-15)

    test.case("and dawson(1) is scipy's 0.5380795069127684")
    match specerf.dawson(1.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 0.5380795069127684, 1e-13)
