// specgamma_tests.nv — the gamma function, its logarithm and the sign
// its logarithm had to drop.
//
// RED ON PURPOSE: every assertion here reaches `not implemented:
// specfun-nv.specgamma.<fn>`.  The suite is the specification the
// implementation has to satisfy, written before the implementation.
//
// The reference values are scipy.special's, at the arguments its own
// test suite uses.  Where a value is not one a reader can check by
// eye, an identity is asserted instead — the factorial recurrence, the
// reflection formula and the symmetry of the beta function are all
// stronger statements than any single number.

use std.test
use specgamma

@test
fn test_gamma_is_the_factorial_at_the_positive_integers() [io]
    test.case("gamma(n) is (n-1)!, exactly the numbers a reader can check")
    match specgamma.gamma(1.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 1.0, 1e-14)
    match specgamma.gamma(5.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 24.0, 1e-13)
    match specgamma.gamma(6.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 120.0, 1e-13)

    test.case("gamma(1/2) is the square root of pi — the value the normal distribution is normalised by")
    match specgamma.gamma(0.5)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 1.7724538509055159, 1e-14)

@test
fn test_the_poles_are_refused_rather_than_approximated() [io]
    // At zero and at every negative integer the limits from the two
    // sides have opposite signs, so there is no value to return and no
    // infinity that is less wrong than the other.
    test.case("zero is a pole")
    match specgamma.gamma(0.0)
        Ok(_)  => test.fail("the gamma function is unbounded at 0")
        Err(_) => test.assert(true)

    test.case("and so is every negative integer")
    match specgamma.gamma(-1.0)
        Ok(_)  => test.fail("the gamma function is unbounded at -1")
        Err(_) => test.assert(true)
    match specgamma.gamma(-3.0)
        Ok(_)  => test.fail("the gamma function is unbounded at -3")
        Err(_) => test.assert(true)

    test.case("a negative NON-integer is an ordinary argument, not a pole")
    match specgamma.gamma(-0.5)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, -3.5449077018110318, 1e-13)

@test
fn test_log_gamma_stays_finite_where_gamma_overflows() [io]
    test.case("log_gamma(1) and log_gamma(2) are both 0, because 0! and 1! are both 1")
    match specgamma.log_gamma(1.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 0.0, 1e-14)
    match specgamma.log_gamma(2.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 0.0, 1e-14)

    test.case("log_gamma(100) is scipy's 359.1342053695754, where gamma(100) is 9.33e155")
    match specgamma.log_gamma(100.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 359.1342053695754, 1e-11)

    test.case("and log_gamma(1000) is finite where gamma(1000) is an infinity")
    match specgamma.log_gamma(1000.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert(v > 5000.0)

@test
fn test_log_gamma_sign_carries_the_half_a_float_could_not() [io]
    // A single Float cannot hold both the magnitude and the sign of a
    // logarithm that is complex on half the negative line.  Returning
    // a NaN there is what every library that got this wrong did.
    test.case("the sign is 1 everywhere the argument is positive")
    match specgamma.log_gamma_sign(0.5)
        Err(e) => test.fail(e.message())
        Ok(s)  => test.assert_approx(s, 1.0, 0.0)
    match specgamma.log_gamma_sign(100.0)
        Err(e) => test.fail(e.message())
        Ok(s)  => test.assert_approx(s, 1.0, 0.0)

    test.case("and it alternates on the negative intervals — gamma(-0.5) is negative")
    match specgamma.log_gamma_sign(-0.5)
        Err(e) => test.fail(e.message())
        Ok(s)  => test.assert_approx(s, -1.0, 0.0)

    test.case("gamma(-1.5) is positive again, one interval further out")
    match specgamma.log_gamma_sign(-1.5)
        Err(e) => test.fail(e.message())
        Ok(s)  => test.assert_approx(s, 1.0, 0.0)

    test.case("the pair is total on exactly the same domain: both refuse a pole")
    match specgamma.log_gamma(-2.0)
        Ok(_)  => test.fail("-2 is a pole of the gamma function")
        Err(_) => test.assert(true)
    match specgamma.log_gamma_sign(-2.0)
        Ok(_)  => test.fail("-2 is a pole of the gamma function")
        Err(_) => test.assert(true)

@test
fn test_digamma_is_the_derivative_of_log_gamma() [io]
    test.case("digamma(1) is the negative of the Euler-Mascheroni constant")
    match specgamma.digamma(1.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, -0.5772156649015329, 1e-14)

    test.case("the recurrence digamma(x+1) = digamma(x) + 1/x holds at x = 1")
    match specgamma.digamma(2.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 0.42278433509846713, 1e-13)

    test.case("and the poles are the gamma function's own")
    match specgamma.digamma(0.0)
        Ok(_)  => test.fail("digamma is unbounded at 0")
        Err(_) => test.assert(true)
    match specgamma.digamma(-1.0)
        Ok(_)  => test.fail("digamma is unbounded at -1")
        Err(_) => test.assert(true)

@test
fn test_beta_is_symmetric_and_is_one_twelfth_at_two_and_three() [io]
    test.case("beta(2, 3) is 1/12")
    match specgamma.beta(2.0, 3.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 0.08333333333333333, 1e-14)

    test.case("and it is symmetric in its arguments")
    match specgamma.beta(3.0, 2.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 0.08333333333333333, 1e-14)

    test.case("beta(1, 1) is 1 — the uniform distribution needs no normalising")
    match specgamma.beta(1.0, 1.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 1.0, 1e-14)

@test
fn test_log_beta_is_finite_where_beta_underflows_and_refuses_a_non_positive() [io]
    test.case("log_beta(2, 3) is the logarithm of one twelfth")
    match specgamma.log_beta(2.0, 3.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, -2.4849066497880004, 1e-13)

    test.case("both arguments have to be strictly positive, and the fault says which")
    match specgamma.log_beta(0.0, 3.0)
        Ok(_)  => test.fail("log_beta needs a > 0")
        Err(_) => test.assert(true)
    match specgamma.log_beta(2.0, -1.0)
        Ok(_)  => test.fail("log_beta needs b > 0")
        Err(_) => test.assert(true)

@test
fn test_the_two_combinatorial_helpers() [io]
    test.case("the rising factorial of 1 to five terms is 5!")
    match specgamma.rising_factorial(1.0, 5)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 120.0, 1e-12)

    test.case("with no terms it is 1, the empty product")
    match specgamma.rising_factorial(3.5, 0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 1.0, 1e-14)

    test.case("a negative number of terms names no product")
    match specgamma.rising_factorial(1.0, -1)
        Ok(_)  => test.fail("a rising factorial has at least zero terms")
        Err(_) => test.assert(true)

    test.case("binomial(5, 2) is the 10 a reader can count")
    match specgamma.binomial(5.0, 2.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 10.0, 1e-12)

    test.case("and binomial(n, 0) is 1 for every n")
    match specgamma.binomial(1000.0, 0.0)
        Err(e) => test.fail(e.message())
        Ok(v)  => test.assert_approx(v, 1.0, 1e-12)
